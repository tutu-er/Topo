# Keep source hashes stable across Windows and Unix checkouts.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
# Frozen observations/results are audited byte-for-byte; never rewrite EOLs.
results_v7/** -text whitespace=cr-at-eol
results_v8/** -text whitespace=cr-at-eol
results_v9/** -text whitespace=cr-at-eol

# Preserve the sealed payload bytes, overriding historic text/EOL rules.
* -text whitespace=cr-at-eol
